APP_NAME="Pharmacy Suite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hms_software
DB_TIMEZONE=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Realtime (Laravel Reverb). Set BROADCAST_CONNECTION=reverb and run
# `php artisan reverb:start` to turn it on; `php artisan reverb:install`
# generates the id, key and secret. With it off, live screens fall back to
# re-fetching. Browsers and phones are told where to connect by the session
# (auth/me), so REVERB_CLIENT_* only needs setting when they must reach Reverb
# at a different address from the one Laravel posts events to.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# REVERB_CLIENT_HOST=
# REVERB_CLIENT_PORT=
# REVERB_CLIENT_SCHEME=

# Push notifications (Firebase Cloud Messaging). `log` writes pushes to the
# log instead of sending. For `fcm`, point FIREBASE_CREDENTIALS at the service
# account JSON from the Firebase console — kept outside the repository.
PUSH_DRIVER=log
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# WhatsApp
#
# `log` writes messages to storage/logs and refuses to run in production.
# Per-clinic credentials are encrypted on the tenant's channel row and always
# win over anything set here; these are the development fallback.
WHATSAPP_PROVIDER=log
WHATSAPP_QUEUE=whatsapp

DIGIWARE_WHATSAPP_BASE_URL=https://lms.digiware.in/api
DIGIWARE_VENDOR_UID=
DIGIWARE_TOKEN=
DIGIWARE_FROM_PHONE_NUMBER_ID=
